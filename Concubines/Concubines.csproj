<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
	  <TargetFramework>netstandard2.0</TargetFramework>
	  <LangVersion>latest</LangVersion>
	  <Nullable>enable</Nullable>
	  <Platforms>x64</Platforms>

	  <BuildForWindows>true</BuildForWindows>
	  <BuildForWindowsStore>true</BuildForWindowsStore>

	  <ModuleId>$(MSBuildProjectName)</ModuleId>
	  <ModuleName>$(MSBuildProjectName)</ModuleName>
	  <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
	  <NugetFolder>$(NUGET_PACKAGES_DIR)</NugetFolder>
	  <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
	  <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bannerlord.ButterLib" Version="2.11.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Bannerlord.MCM" Version="5.12.3" />
        <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.4.8.119303" />
        <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Bastards">
        <HintPath>$(BANNERLORD_GAME_DIR)\Modules\Bastards\bin\Win64_Shipping_Client\Bastards.dll</HintPath>
      </Reference>
      <Reference Include="BetterCore">
        <HintPath>$(BANNERLORD_GAME_DIR)\Modules\BetterCore\bin\Win64_Shipping_Client\BetterCore.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <None Update="_Module\SubModule.xml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <Exec Command="IF EXIST &quot;$(GameFolder)\Modules\$(MSBuildProjectName)&quot; RMDIR /Q /S &quot;$(GameFolder)\Modules\$(MSBuildProjectName)&quot;" />
    </Target>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="IF NOT &quot;$(GameFolder)&quot;==&quot;&quot; MKDIR &quot;$(GameFolder)\Modules\$(MSBuildProjectName)&quot;" />
        <Exec Command="IF NOT &quot;$(GameFolder)&quot;==&quot;&quot; MKDIR &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Win64_Shipping_Client&quot;" />
        <Exec Command="IF NOT &quot;$(GameFolder)&quot;==&quot;&quot; MKDIR &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Gaming.Desktop.x64_Shipping_Client&quot;" />
        <Exec Command="IF NOT &quot;$(GameFolder)&quot;==&quot;&quot; XCOPY /Y /E /H /C /I &quot;$(MSBuildProjectDirectory)\_Module&quot; &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\&quot;" />
        <Exec Command="IF NOT &quot;$(GameFolder)&quot;==&quot;&quot; XCOPY /Y &quot;$(TargetPath)&quot; &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Win64_Shipping_Client\&quot;" />
        <Exec Command="IF NOT &quot;$(GameFolder)&quot;==&quot;&quot; XCOPY /Y &quot;$(TargetPath)&quot; &quot;$(GameFolder)\Modules\$(MSBuildProjectName)\bin\Gaming.Desktop.x64_Shipping_Client\&quot;" />
    </Target>

    <PropertyGroup>
        <PackageDir>$(MSBuildProjectDirectory)\..\dist</PackageDir>
        <PackageStaging>$(MSBuildProjectDirectory)\obj\package</PackageStaging>
    </PropertyGroup>

    <Target Name="Package" AfterTargets="Build">
        <PropertyGroup>
            <PackageStamp>$([System.DateTime]::Now.ToString('yyyyMMdd-HHmm'))</PackageStamp>
            <PackageZip>$(PackageDir)\$(ModuleId)-$(PackageStamp).zip</PackageZip>
        </PropertyGroup>
        <RemoveDir Directories="$(PackageStaging)" />
        <MakeDir Directories="$(PackageDir)" />
        <ItemGroup>
            <PackageModuleFiles Include="$(MSBuildProjectDirectory)\_Module\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(PackageModuleFiles)" DestinationFiles="@(PackageModuleFiles -> '$(PackageStaging)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PackageStaging)\bin\Win64_Shipping_Client\$(TargetFileName)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PackageStaging)\bin\Gaming.Desktop.x64_Shipping_Client\$(TargetFileName)" />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(PackageStaging)\*' -DestinationPath '$(PackageZip)' -Force&quot;" />
        <Message Text="Packaged module: $(PackageZip)" Importance="high" />
    </Target>

</Project>
